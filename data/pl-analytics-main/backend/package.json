{
  "name": "@pl-analytics/backend",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "type-check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "worker": "tsx src/workers/ingestion.worker.ts",
    "ingest": "tsx src/jobs/ingestion.ts",
    "ingest:pl": "tsx src/jobs/ingestion.ts 8"
  },
  "engines": { "node": ">=20.0.0" },
  "prisma": { "seed": "tsx prisma/seed.ts" },
  "dependencies": {
    "@pl-analytics/shared": "^1.0.0",
    "@prisma/client": "^5.7.0",
    "bullmq": "^5.1.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "meilisearch": "^0.29.0",
    "morgan": "^1.10.0",
    "@sentry/node": "^8.0.0",
    "stripe": "^14.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.10.5",
    "prisma": "^5.7.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  }
}
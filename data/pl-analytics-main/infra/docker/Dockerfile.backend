FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json package-lock.json* ./
COPY backend/package.json backend/package-lock.json* ./backend/
COPY frontend/package.json frontend/package-lock.json* ./frontend/
COPY shared/package.json ./shared/

RUN npm ci

# Generate Prisma client (schema must be present for this to work)
COPY backend/prisma ./backend/prisma
WORKDIR /app/backend
RUN npx prisma generate

# Build backend
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY . .

# Build shared first: backend imports @pl-analytics/shared
RUN npm run build --workspace=shared

WORKDIR /app/backend
RUN npm run build

# Production image
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Copy BOTH root and backend node_modules: the @pl-analytics/shared workspace
# symlink lives in the root node_modules.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/backend/node_modules ./backend/node_modules
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/package.json ./backend/package.json
COPY --from=builder /app/backend/prisma ./backend/prisma

USER nextjs

EXPOSE 3001

ENV PORT=3001

# Run migrations before serving is done by the deploy pipeline (db:migrate:prod).
CMD ["node", "backend/dist/index.js"]

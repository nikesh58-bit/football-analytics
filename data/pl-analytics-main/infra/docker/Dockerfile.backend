FROM node:20-alpine AS base

# Install dependencies only when needed
FROM base AS deps
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app

COPY package.json package-lock.json* ./
COPY backend/package.json backend/package-lock.json* ./backend/
COPY frontend/package.json frontend/package-lock.json* ./frontend/
COPY shared/package.json ./shared/

RUN npm ci

# Generate Prisma client (schema must be present for this to work)
COPY backend/prisma ./backend/prisma
WORKDIR /app/backend
RUN npx prisma generate

# Build backend
FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

# Build shared first: backend imports @pl-analytics/shared
RUN npm run build --workspace=shared

WORKDIR /app/backend
RUN npm run build

# Production image
FROM base AS runner
WORKDIR /app

# Prisma client needs openssl/libc6-compat at RUNTIME on Alpine
RUN apk add --no-cache openssl libc6-compat

ENV NODE_ENV=production

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

# Root node_modules holds all hoisted workspace deps + the
# @pl-analytics/shared symlink.
COPY --from=deps /app/node_modules ./node_modules
COPY --from=builder /app/shared ./shared
COPY --from=builder /app/backend/dist ./backend/dist
COPY --from=builder /app/backend/package.json ./backend/package.json
COPY --from=builder /app/backend/prisma ./backend/prisma

USER nextjs

EXPOSE 3001

ENV PORT=3001

# Free-tier Render has no preDeployCommand, so schema+seed runs at container
# start. Seed is idempotent (upserts). After real migrations exist, switch to
# migrate deploy.
CMD ["sh", "-c", "cd backend && npx prisma db push --skip-generate && npx prisma db seed && node dist/index.js"]
